# The public origin this site is served from. Used for canonical URLs, Open
# Graph tags and the <loc> entries in sitemap.xml.
#
# If it is missing, empty, or not a valid URL, the build still succeeds: it
# falls back to https://all-in-tools.vercel.app and prints a [config] warning.
# That is harmless locally and wrong in production, so set it for every Vercel
# environment you deploy (previews can be left unset — the URL changes per
# build, and the warning is the reminder).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
