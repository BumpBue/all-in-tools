# The public origin this site is served from. Used for canonical URLs, Open
# Graph tags and the <loc> entries in sitemap.xml.
#
# Without it the build falls back to a placeholder host, which is harmless
# locally and wrong in production. On Vercel, set it for every environment
# you deploy (or leave it unset on previews, where the URL changes per build).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
